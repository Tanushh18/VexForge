# --- Where to deliver results ---
# The deployed API. Use http://localhost:4000 while you're running everything
# on one machine.
VEXFORGE_API_URL=https://vexforge-api.onrender.com

# Must match WORKER_API_KEY on the server exactly. Generate once with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# The server fails closed (503) until it's set on both sides.
WORKER_API_KEY=

# Shows up in the console's worker badge — name it after the machine so you can
# tell which one is online.
WORKER_ID=desktop

# How often to ask the server for work. Lower feels snappier when you click
# "Start run"; higher is kinder to a free-tier instance.
WORKER_POLL_MS=15000

# --- Local models (Ollama, on THIS machine) ---
# The worker drafts and scores locally, which is the whole point: Ollama is on
# localhost here, so drafting can't silently go missing the way it would if the
# server had to reach a model across a tunnel.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL_REASONING=qwen2.5:14b-instruct
OLLAMA_MODEL_DRAFTING=qwen2.5:7b-instruct
OLLAMA_MODEL_FAST=qwen2.5:3b-instruct

# Smaller machine? Collapse all three roles onto one model:
# OLLAMA_MODEL_ALL=qwen2.5:7b-instruct

# MEMORY WARNING: Ollama keeps up to three models resident by default and only
# evicts after ~5 minutes idle. A run touches all three roles back to back, so
# you can end up with ~16GB loaded (9 + 5 + 2). On a 16GB machine that swaps,
# and swapping a 9GB model looks exactly like a hang. Set this in Ollama's own
# environment (not here) to load one at a time:
#   OLLAMA_MAX_LOADED_MODELS=1
