# --- Where to deliver results ---
# The deployed API. Use http://localhost:4000 while you're running everything
# on one machine.
VEXFORGE_API_URL=https://vexforge-api.onrender.com

# Must match WORKER_API_KEY on the server exactly. Generate once with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# The server fails closed (503) until it's set on both sides.
WORKER_API_KEY=

# Shows up in the console's worker badge — name it after the machine so you can
# tell which one is online.
WORKER_ID=desktop

# How often to ask the server for work. Lower feels snappier when you click
# "Start run"; higher is kinder to a free-tier instance.
WORKER_POLL_MS=15000

# --- Models (Groq, hosted — no local model needed) ---
# Comma-separated free-tier API keys from console.groq.com/keys. Used as pure
# fallback, not load-balancing: the worker uses the first key until it's
# rate-limited (429) or rejected (401/403), then rotates to the next one.
# Holding several keys multiplies the effective daily budget for free.
GROQ_API_KEYS=

# Model per role — see shared/modelRouter.js. Defaults to gpt-oss if left
# unset; check console.groq.com/settings/limits → Chat Completions for what's
# actually on your account before overriding. Never use a *-prompt-guard-* or
# *-safeguard-* model — those are classifiers, not chat models.
# GROQ_MODEL_REASONING=openai/gpt-oss-120b
# GROQ_MODEL_DRAFTING=openai/gpt-oss-20b
# GROQ_MODEL_FAST=openai/gpt-oss-20b

# Collapse all three roles onto one model:
# GROQ_MODEL_ALL=openai/gpt-oss-20b
