# --- Core ---
PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/vexforge_hq
JWT_SECRET=change_this_to_a_long_random_string
CLIENT_ORIGIN=http://localhost:5173

# CEO login (single admin account — you)
CEO_EMAIL=you@vexforge.dev
CEO_PASSWORD=change_this_password
CEO_NAME=Yashasvi

# --- Chatbot (local Qwen model, via the separate VexForge-LocalLLM project) ---
# No paid API key needed. Run ../VexForge-LocalLLM (see its README) and point this at it —
# localhost by default, or a tunnel URL if it's running on a different machine.
LOCAL_LLM_URL=http://localhost:5001

# --- Email outreach (nodemailer) ---
# Only used when YOU click "Send" on an approved draft — nothing sends automatically.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=VexForge
SMTP_FROM_EMAIL=

# --- Optional: call transcription (OpenAI Whisper-compatible endpoint) ---
# If unset, the Support page still works — you just paste transcripts in manually.
TRANSCRIBE_API_KEY=
TRANSCRIBE_API_URL=https://api.openai.com/v1/audio/transcriptions

# --- Optional: Telegram push notifications ---
# New draft ready, ticket escalated, lead replied, weekly digest. Message @BotFather on
# Telegram to create a bot and get a token; message your new bot once, then get your chat id
# from https://api.telegram.org/bot<token>/getUpdates (look for "chat":{"id": ...}).
# Leave blank to skip — every notification call is a no-op without these.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Optional: reply detection (IMAP) ---
# Polls an inbox for replies from known leads and flips them to "responded" automatically.
# Defaults to the SMTP_USER/SMTP_PASS above if unset (same Gmail account, different protocol) —
# set these separately only if replies land in a different inbox. Needs an app password, same
# as SMTP. Leave IMAP_HOST blank to skip reply detection entirely.
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=

# --- Optional: follow-up nudges ---
# Days a lead can sit in "outreach_sent" with no reply before a follow-up draft is queued.
FOLLOWUP_AFTER_DAYS=4
