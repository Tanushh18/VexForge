# --- Core ---
PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/vexforge_hq
JWT_SECRET=change_this_to_a_long_random_string
# Comma-separated list. Local dev needs only the Vite server; add your deployed
# console and marketing site origins here when they talk to this API across a
# tunnel (different origin = CORS applies).
#   CLIENT_ORIGIN=https://vexforge-hq.onrender.com,https://vexforge-site.onrender.com
CLIENT_ORIGIN=http://localhost:5173

# CEO login (single admin account — you)
CEO_EMAIL=you@vexforge.dev
CEO_PASSWORD=change_this_password
CEO_NAME=Yashasvi

# --- Models (Groq, hosted — no local model needed) ---
# Free-tier API keys from console.groq.com/keys, comma-separated. Three roles,
# one shared backend — see shared/modelRouter.js. Used as pure fallback: the
# first key is used until it's rate-limited (429) or rejected (401/403), then
# the next one takes over. Holding several keys multiplies the effective
# daily free-tier budget.
GROQ_API_KEYS=

# Check console.groq.com/settings/limits → Chat Completions for what's
# actually on your account before overriding these — the catalog varies.
# Never use a *-prompt-guard-* or *-safeguard-* model here: those are
# injection/content classifiers, not chat models.
#
# The decision-maker: lead scoring, fit assessment, digests, anything that
# changes what the pipeline does. Worth the bigger model.
# GROQ_MODEL_REASONING=openai/gpt-oss-120b
# Outreach copy — fluency matters more than judgement here.
# GROQ_MODEL_DRAFTING=openai/gpt-oss-20b
# Classification and one-line summaries; runs constantly, so it stays small.
# GROQ_MODEL_FAST=openai/gpt-oss-20b

# Escape hatch: collapse all three roles onto one model.
# GROQ_MODEL_ALL=openai/gpt-oss-20b

# --- Email outreach (nodemailer) ---
# Only used when YOU click "Send" on an approved draft — nothing sends automatically.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=VexForge
SMTP_FROM_EMAIL=

# --- Optional: call transcription (OpenAI Whisper-compatible endpoint) ---
# If unset, the Support page still works — you just paste transcripts in manually.
TRANSCRIBE_API_KEY=
TRANSCRIBE_API_URL=https://api.openai.com/v1/audio/transcriptions

# --- Optional: Telegram push notifications ---
# New draft ready, ticket escalated, lead replied, weekly digest. Message @BotFather on
# Telegram to create a bot and get a token; message your new bot once, then get your chat id
# from https://api.telegram.org/bot<token>/getUpdates (look for "chat":{"id": ...}).
# Leave blank to skip — every notification call is a no-op without these.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Optional: reply detection (IMAP) ---
# Polls an inbox for replies from known leads and flips them to "responded" automatically.
# Defaults to the SMTP_USER/SMTP_PASS above if unset (same Gmail account, different protocol) —
# set these separately only if replies land in a different inbox. Needs an app password, same
# as SMTP. Leave IMAP_HOST blank to skip reply detection entirely.
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=

# --- Optional: follow-up nudges ---
# Days a lead can sit in "outreach_sent" with no reply before a follow-up draft is queued.
FOLLOWUP_AFTER_DAYS=4

# --- Lead pipeline ---
# Hard ceiling on automated cold emails per day. This is a deliverability control: a new
# sending domain that fires a hundred cold emails in an afternoon gets marked as spam, and
# that reputation then follows every later message. Raise it slowly, if at all.
DAILY_SEND_CAP=25

# How many companies to pull from each discovery source per run.
PIPELINE_PER_SOURCE=12
# There are 20 discovery sources; crawling all of them sequentially every run is slow and
# impolite to the sites being scraped. A run that doesn't explicitly choose sources (the
# scheduled job, or the console's "Run next batch" button) gets this many off a rotation
# cursor instead, cycling through all 20 roughly every ceil(20/N) runs.
PIPELINE_ROTATION_BATCH_SIZE=8
# After scoring, auto-draft outreach for at most this many of the top leads. Drafts still
# sit in the approval queue — this never sends anything.
PIPELINE_AUTO_DRAFT_TOP=5
# Minimum score (0-100) a lead needs before the pipeline will draft for it at all.
PIPELINE_MIN_DRAFT_SCORE=60

# Run the whole pipeline on a schedule. Off by default — an unattended crawler that starts
# itself the first time you run `npm run dev` is not a good default. Set to true once you've
# watched a manual run from the Lead Pipeline page and are happy with what it finds.
PIPELINE_SCHEDULE_ENABLED=false
PIPELINE_EVERY_HOURS=24

# --- Local worker ---
# Shared secret the worker (worker/) authenticates with. Discovery and deep scans
# run on your own machine because Chromium needs ~730MB; the worker delivers results
# here over HTTP. Must match WORKER_API_KEY in worker/.env exactly. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Until it's set, every worker endpoint returns 503 — it fails closed on purpose,
# since an unset key must never mean "anyone may post leads into the CRM".
WORKER_API_KEY=

# How long without a poll before the console shows the worker as offline.
WORKER_STALE_AFTER_MS=45000

# --- GitHub Actions instant-trigger (optional) ---
# Without this, a run queued from the console (or the scheduled job) just sits
# until the Actions workflow's own daily cron finds it, or you click "Run
# workflow" by hand. Set these four and the server wakes the workflow the
# moment a run is queued instead — skipped automatically if a local worker
# already polled recently, since its atomic job-claim makes a redundant
# Actions run harmless but wasteful of Actions minutes.
#
# GITHUB_TRIGGER_TOKEN must be a FINE-GRAINED personal access token
# (github.com/settings/personal-access-tokens/new), scoped to ONLY this
# repository, with ONLY "Actions: read and write" permission — no code
# access, no other repos, no secrets access. Give it an expiry (GitHub
# requires one for fine-grained tokens) so a forgotten leak doesn't stay live.
# That scope is what makes holding this on a public server a reasonable
# trade: leaked, the worst it can do is start/cancel workflow runs here.
GITHUB_TRIGGER_TOKEN=
GITHUB_TRIGGER_OWNER=
GITHUB_TRIGGER_REPO=
GITHUB_TRIGGER_WORKFLOW=pipeline.yml
GITHUB_TRIGGER_REF=main
