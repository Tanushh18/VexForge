# --- Core ---
PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/vexforge_hq
JWT_SECRET=change_this_to_a_long_random_string
CLIENT_ORIGIN=http://localhost:5173

# CEO login (single admin account — you)
CEO_EMAIL=you@vexforge.dev
CEO_PASSWORD=change_this_password
CEO_NAME=Yashasvi

# --- Local models (Ollama) ---
# Everything runs locally; no paid API key anywhere. Three roles, three models — see
# src/services/modelRouter.js. Pull them once with:
#   ollama pull qwen2.5:14b-instruct && ollama pull qwen2.5:7b-instruct && ollama pull qwen2.5:3b-instruct
OLLAMA_URL=http://localhost:11434

# The decision-maker: lead scoring, fit assessment, digests, anything that changes what the
# pipeline does. This is the one worth giving the most RAM. Needs ~10GB free; drop to
# qwen2.5:7b-instruct on a 16GB machine, or use OLLAMA_MODEL_ALL below.
OLLAMA_MODEL_REASONING=qwen2.5:14b-instruct
# Outreach copy — fluency matters more than judgement here.
OLLAMA_MODEL_DRAFTING=qwen2.5:7b-instruct
# Classification and one-line summaries; runs constantly, so it stays small.
OLLAMA_MODEL_FAST=qwen2.5:3b-instruct

# Escape hatch: collapse all three roles onto one model on a smaller machine.
# OLLAMA_MODEL_ALL=qwen2.5:7b-instruct

# Backend selection: auto (prefer Ollama, fall back to the old service) | ollama | localllm
LLM_BACKEND=auto
# Only used when LLM_BACKEND resolves to localllm — the separate VexForge-LocalLLM project.
LOCAL_LLM_URL=http://localhost:5001

# --- Email outreach (nodemailer) ---
# Only used when YOU click "Send" on an approved draft — nothing sends automatically.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=VexForge
SMTP_FROM_EMAIL=

# --- Optional: call transcription (OpenAI Whisper-compatible endpoint) ---
# If unset, the Support page still works — you just paste transcripts in manually.
TRANSCRIBE_API_KEY=
TRANSCRIBE_API_URL=https://api.openai.com/v1/audio/transcriptions

# --- Optional: Telegram push notifications ---
# New draft ready, ticket escalated, lead replied, weekly digest. Message @BotFather on
# Telegram to create a bot and get a token; message your new bot once, then get your chat id
# from https://api.telegram.org/bot<token>/getUpdates (look for "chat":{"id": ...}).
# Leave blank to skip — every notification call is a no-op without these.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Optional: reply detection (IMAP) ---
# Polls an inbox for replies from known leads and flips them to "responded" automatically.
# Defaults to the SMTP_USER/SMTP_PASS above if unset (same Gmail account, different protocol) —
# set these separately only if replies land in a different inbox. Needs an app password, same
# as SMTP. Leave IMAP_HOST blank to skip reply detection entirely.
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=

# --- Optional: follow-up nudges ---
# Days a lead can sit in "outreach_sent" with no reply before a follow-up draft is queued.
FOLLOWUP_AFTER_DAYS=4

# --- Lead pipeline ---
# Hard ceiling on automated cold emails per day. This is a deliverability control: a new
# sending domain that fires a hundred cold emails in an afternoon gets marked as spam, and
# that reputation then follows every later message. Raise it slowly, if at all.
DAILY_SEND_CAP=25

# How many companies to pull from each discovery source per run.
PIPELINE_PER_SOURCE=12
# After scoring, auto-draft outreach for at most this many of the top leads. Drafts still
# sit in the approval queue — this never sends anything.
PIPELINE_AUTO_DRAFT_TOP=5
# Minimum score (0-100) a lead needs before the pipeline will draft for it at all.
PIPELINE_MIN_DRAFT_SCORE=60

# Run the whole pipeline on a schedule. Off by default — an unattended crawler that starts
# itself the first time you run `npm run dev` is not a good default. Set to true once you've
# watched a manual run from the Lead Pipeline page and are happy with what it finds.
PIPELINE_SCHEDULE_ENABLED=false
PIPELINE_EVERY_HOURS=24
